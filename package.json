{
  "name": "five-nines",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Five Nines: build servers, homelabs and mini datacenters for clients. Simulation driven by real hardware specs.",
  "scripts": {
    "dev": "npm run gen:data && vite",
    "gen:data": "node scripts/build-game-data.js",
    "build": "npm run gen:data && vite build && node scripts/check-dist-brands.js",
    "preview": "vite preview",
    "test": "npm run gen:data && vitest run",
    "calibrate": "npm run gen:data && node scripts/calibrate.js"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
